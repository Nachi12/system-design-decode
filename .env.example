# Server Configuration
PORT=3001
NODE_ENV=development

# PostgreSQL Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/seatlock_db
PGHOST=localhost
PGPORT=5432
PGDATABASE=seatlock_db
PGUSER=postgres
PGPASSWORD=postgres
PGSSL=false

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Concurrency & Lease Timing
REDIS_LOCK_TTL_MS=5000
HOLD_DURATION_SECONDS=60
ENABLE_REDIS_FALLBACK=true
