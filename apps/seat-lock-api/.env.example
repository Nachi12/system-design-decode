# Server Configuration
PORT=3001
NODE_ENV=development

# PostgreSQL Configuration
# You can provide DATABASE_URL or individual PG* variables
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/seatlock_db
PGHOST=localhost
PGPORT=5432
PGDATABASE=seatlock_db
PGUSER=postgres
PGPASSWORD=postgres
PGSSL=false

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Concurrency & Lease Timing (in milliseconds & seconds)
# Short-lived coordination lock TTL (ingress shield)
REDIS_LOCK_TTL_MS=5000

# Authoritative seat hold duration (user checkout lease window)
HOLD_DURATION_SECONDS=60

# Safe fallback to PostgreSQL-only invariant arbitration when Redis is unreachable
ENABLE_REDIS_FALLBACK=true
